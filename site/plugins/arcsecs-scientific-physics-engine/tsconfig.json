{
  "compilerOptions": {
    "module": "ES2015",
    "target": "ES2015",
    "strict": true,
    "noImplicitAny": true,
    "noEmitOnError": true,
    "removeComments": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "outDir": "wwwroot/js",
    "useUnknownInCatchVariables": true,
    "noImplicitOverride": true,
    "allowUnusedLabels": false
  },
  "include": [
    "src/**/*.ts"
  ]
}
