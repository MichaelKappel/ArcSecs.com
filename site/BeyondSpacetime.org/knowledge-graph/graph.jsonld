c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/es/glossary/1"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","definesForLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Alight-slowing"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=glossary%3Aes%3A2","@type":"ScientificRecord","identifier":"glossary:es:2","kind":"glossary","label":{"@value":"Tiempo propio","@language":"es"},"description":{"@value":"Tiempo medido por un reloj ideal a lo largo de su línea de universo en relatividad.","@language":"es"},"language":"es","status":"","recordPage":"https://beyondspacetime.org/global/es/glossary/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/168"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/es/glossary/2"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","definesForLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Aconstant-time"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=glossary%3Aes%3A3","@type":"ScientificRecord","identifier":"glossary:es:3","kind":"glossary","label":{"@value":"Progresión universal T","@language":"es"},"description":{"@value":"Parámetro común de evolución propuesto; no es un reloj absoluto establecido experimentalmente.","@language":"es"},"language":"es","status":"","recordPage":"https://beyondspacetime.org/global/es/glossary/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/169"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/es/glossary/3"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","definesForLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Awhen"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=glossary%3Aes%3A4","@type":"ScientificRecord","identifier":"glossary:es:4","kind":"glossary","label":{"@value":"Frente causal","@language":"es"},"description":{"@value":"Límite delantero de una perturbación causal en una teoría dada, no necesariamente la velocidad de grupo.","@language":"es"},"language":"es","status":"","recordPage":"https://beyondspacetime.org/global/es/glossary/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/170"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/es/glossary/4"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","definesForLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Afastest-signal"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=glossary%3Aes%3A5","@type":"ScientificRecord","identifier":"glossary:es:5","kind":"glossary","label":{"@value":"Tasa de separación","@language":"es"},"description":{"@value":"Variación de distancia por unidad de tiempo según una convención de coordenadas; no equivale necesariamente a una velocidad relativa local.","@language":"es"},"language":"es","status":"","recordPage":"https://beyondspacetime.org/global/es/glossary/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/171"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/es/glossary/5"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","definesForLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Aseparation"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=glossary%3Aes%3A6","@type":"ScientificRecord","identifier":"glossary:es:6","kind":"glossary","label":{"@value":"Horizonte observable","@language":"es"},"description":{"@value":"Límite de accesibilidad causal determinado por la historia cósmica supuesta, no necesariamente una pared física.","@language":"es"},"language":"es","status":"","recordPage":"https://beyondspacetime.org/global/es/glossary/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/172"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/es/glossary/6"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","definesForLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Acosmic-size"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=glossary%3Aes%3A7","@type":"ScientificRecord","identifier":"glossary:es:7","kind":"glossary","label":{"@value":"Constante de Hubble","@language":"es"},"description":{"@value":"Parámetro de la tasa de expansión actual en un modelo cosmológico convencional.","@language":"es"},"language":"es","status":"","recordPage":"https://beyondspacetime.org/global/es/glossary/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/173"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/es/glossary/7"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","definesForLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Acosmic-age"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=glossary%3Aes%3A8","@type":"ScientificRecord","identifier":"glossary:es:8","kind":"glossary","label":{"@value":"Sesgo de distancia","@language":"es"},"description":{"@value":"Diferencia entre una distancia inferida y otra calibrada bajo supuestos declarados. Puede tener ambos signos.","@language":"es"},"language":"es","status":"","recordPage":"https://beyondspacetime.org/global/es/glossary/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/174"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/es/glossary/8"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","definesForLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Adistance-inference"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=glossary%3Aes%3A9","@type":"ScientificRecord","identifier":"glossary:es:9","kind":"glossary","label":{"@value":"Control negativo","@language":"es"},"description":{"@value":"Condición especificada del modelo que debe eliminar un efecto o revelar un fallo; superarlo no es una validación empírica.","@language":"es"},"language":"es","status":"","recordPage":"https://beyondspacetime.org/global/es/glossary/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/175"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/es/glossary/9"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","definesForLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Aspacetime"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=glossary%3Afr%3A0","@type":"ScientificRecord","identifier":"glossary:fr:0","kind":"glossary","label":{"@value":"Masse invariante","@language":"fr"},"description":{"@value":"Masse définie par l’invariant énergie-impulsion total, et non simplement par l’énergie divisée par c².","@language":"fr"},"language":"fr","status":"","recordPage":"https://beyondspacetime.org/global/fr/glossary/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/188"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/fr/glossary/0"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","definesForLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Aphoton-mass"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=glossary%3Afr%3A1","@type":"ScientificRecord","identifier":"glossary:fr:1","kind":"glossary","label":{"@value":"Vitesse de groupe","@language":"fr"},"description":{"@value":"Vitesse de propagation de l’enveloppe d’un paquet d’ondes pour une dispersion donnée. Distincte de la vitesse du front.","@language":"fr"},"language":"fr","status":"","recordPage":"https://beyondspacetime.org/global/fr/glossary/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/189"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/fr/glossary/1"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","definesForLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Alight-slowing"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=glossary%3Afr%3A2","@type":"ScientificRecord","identifier":"glossary:fr:2","kind":"glossary","label":{"@value":"Temps propre","@language":"fr"},"description":{"@value":"Temps mesuré par une horloge idéale le long de sa ligne d’univers en relativité.","@language":"fr"},"language":"fr","status":"","recordPage":"https://beyondspacetime.org/global/fr/glossary/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/190"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/fr/glossary/2"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","definesForLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Aconstant-time"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=glossary%3Afr%3A3","@type":"ScientificRecord","identifier":"glossary:fr:3","kind":"glossary","label":{"@value":"Progression universelle T","@language":"fr"},"description":{"@value":"Paramètre commun d’évolution proposé ; pas une horloge absolue établie expérimentalement.","@language":"fr"},"language":"fr","status":"","recordPage":"https://beyondspacetime.org/global/fr/glossary/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/191"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/fr/glossary/3"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","definesForLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Awhen"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=glossary%3Afr%3A4","@type":"ScientificRecord","identifier":"glossary:fr:4","kind":"glossary","label":{"@value":"Front causal","@language":"fr"},"description":{"@value":"Limite avant d’une perturbation causale dans une théorie donnée, distincte en général de la vitesse de groupe.","@language":"fr"},"language":"fr","status":"","recordPage":"https://beyondspacetime.org/global/fr/glossary/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/192"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/fr/glossary/4"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","definesForLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Afastest-signal"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=glossary%3Afr%3A5","@type":"ScientificRecord","identifier":"glossary:fr:5","kind":"glossary","label":{"@value":"Taux de séparation","@language":"fr"},"description":{"@value":"Variation de distance par unité de temps selon une convention de coordonnées ; pas nécessairement une vitesse relative locale.","@language":"fr"},"language":"fr","status":"","recordPage":"https://beyondspacetime.org/global/fr/glossary/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/193"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/fr/glossary/5"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","definesForLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Aseparation"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=glossary%3Afr%3A6","@type":"ScientificRecord","identifier":"glossary:fr:6","kind":"glossary","label":{"@value":"Horizon observable","@language":"fr"},"description":{"@value":"Limite d’accessibilité causale déterminée par l’histoire cosmique supposée, pas nécessairement une paroi physique.","@language":"fr"},"language":"fr","status":"","recordPage":"https://beyondspacetime.org/global/fr/glossary/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/194"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/fr/glossary/6"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","definesForLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Acosmic-size"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=glossary%3Afr%3A7","@type":"ScientificRecord","identifier":"glossary:fr:7","kind":"glossary","label":{"@value":"Constante de Hubble","@language":"fr"},"description":{"@value":"Paramètre du taux d’expansion actuel dans un modèle cosmologique conventionnel.","@language":"fr"},"language":"fr","status":"","recordPage":"https://beyondspacetime.org/global/fr/glossary/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/195"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/fr/glossary/7"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","definesForLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Acosmic-age"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=glossary%3Afr%3A8","@type":"ScientificRecord","identifier":"glossary:fr:8","kind":"glossary","label":{"@value":"Biais de distance","@language":"fr"},"description":{"@value":"Différence entre une distance inférée et une distance calibrée sous des hypothèses déclarées. Peut être de signe positif ou négatif.","@language":"fr"},"language":"fr","status":"","recordPage":"https://beyondspacetime.org/global/fr/glossary/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/196"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/fr/glossary/8"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","definesForLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Adistance-inference"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=glossary%3Afr%3A9","@type":"ScientificRecord","identifier":"glossary:fr:9","kind":"glossary","label":{"@value":"Contrôle négatif","@language":"fr"},"description":{"@value":"Condition spécifiée du modèle censée supprimer un effet ou révéler un échec ; la réussir ne constitue pas une validation empirique.","@language":"fr"},"language":"fr","status":"","recordPage":"https://beyondspacetime.org/global/fr/glossary/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/197"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/fr/glossary/9"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","definesForLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Aspacetime"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=model%3Aevidence%3Aanchors","@type":"ScientificRecord","identifier":"model:evidence:anchors","kind":"model","label":{"@val