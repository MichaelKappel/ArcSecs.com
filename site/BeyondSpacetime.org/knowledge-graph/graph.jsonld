ord/?id=translation%3Aen%3Afastest-signal","@type":"ScientificRecord","identifier":"translation:en:fastest-signal","kind":"lesson","label":{"@value":"Group speed and causal speed","@language":"en"},"description":{"@value":"A field characteristic may be faster than a slow massive packet without exceeding the local causal maximum. No controllable faster-than-light signal is demonstrated.","@language":"en"},"language":"en","status":"Educational lesson","recordPage":"https://beyondspacetime.org/global/en/fastest-signal/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/139"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/en/lessons/7"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Afastest-signal"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Afastest-signal","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Afastest-signal"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Alight-slowing","@type":"ScientificRecord","identifier":"translation:en:light-slowing","kind":"lesson","label":{"@value":"Distinguishing energy loss from slowing","@language":"en"},"description":{"@value":"Energy, frequency and group speed are distinct. A fixed-gap drag model permits energy loss with very little speed change, and the zero-gap limit does not slow at all.","@language":"en"},"language":"en","status":"Educational lesson","recordPage":"https://beyondspacetime.org/global/en/light-slowing/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/134"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/en/lessons/2"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Alight-slowing"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Alight-slowing","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Alight-slowing"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Aphoton-mass","@type":"ScientificRecord","identifier":"translation:en:photon-mass","kind":"lesson","label":{"@value":"Light, energy and invariant mass","@language":"en"},"description":{"@value":"Light has measurable energy and momentum. A nonzero invariant photon rest mass is a separate hypothesis, not a consequence of radiation pressure or gravity.","@language":"en"},"language":"en","status":"Educational lesson","recordPage":"https://beyondspacetime.org/global/en/photon-mass/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/132"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/en/lessons/0"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Aphoton-mass"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Aphoton-mass","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Aphoton-mass"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Aphysical-existence","@type":"ScientificRecord","identifier":"translation:en:physical-existence","kind":"lesson","label":{"@value":"Physical attributes and system mass","@language":"en"},"description":{"@value":"Physical states carry measurable energy and momentum, but energy-equivalent mass, invariant mass and geometric extent are distinct quantities.","@language":"en"},"language":"en","status":"Educational lesson","recordPage":"https://beyondspacetime.org/global/en/physical-existence/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/137"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/en/lessons/5"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Aphysical-existence"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Aphysical-existence","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Aphysical-existence"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Aseparation","@type":"ScientificRecord","identifier":"translation:en:separation","kind":"lesson","label":{"@value":"Closing and separation rates versus causality","@language":"en"},"description":{"@value":"Coordinate separation rates may exceed a local light-speed benchmark; this does not imply that one body or signal travels locally faster than c.","@language":"en"},"language":"en","status":"Educational lesson","recordPage":"https://beyondspacetime.org/global/en/separation/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/140"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/en/lessons/8"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Aseparation"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Aseparation","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Aseparation"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Aspacetime","@type":"ScientificRecord","identifier":"translation:en:spacetime","kind":"lesson","label":{"@value":"Geometry versus a literal fabric","@language":"en"},"description":{"@value":"Relativistic geometry is a successful predictive framework. Rejecting a literal fabric metaphor does not reject measured proper times, trajectories or gravity.","@language":"en"},"language":"en","status":"Educational lesson","recordPage":"https://beyondspacetime.org/global/en/spacetime/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/138"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/en/lessons/6"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Aspacetime"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Aspacetime","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Aspacetime"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Awhen","@type":"ScientificRecord","identifier":"translation:en:when","kind":"lesson","label":{"@value":"Time as event ordering","@language":"en"},"description":{"@value":"The charter treats When as a relation between events. That ontological choice must be distinguished from measured duration and relativistic proper time.","@language":"en"},"language":"en","status":"Educational lesson","recordPage":"https://beyondspacetime.org/global/en/when/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/135"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/en/lessons/3"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Awhen"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Awhen","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Awhen"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Awhere","@type":"ScientificRecord","identifier":"translation:en:where","kind":"lesson","label":{"@value":"Space as measurable relations","@language":"en"},"description":{"@value":"Relative position, separation and geometry are measurable. The choice not to call space a material does not remove geometric laws.","@language":"en"},"language":"en","status":"Educational lesson","recordPage":"https://beyondspacetime.org/global/en/where/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/136"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/en/lessons/4"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Awhere"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Awhere","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Awhere"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Aconstant-time","@type":"ScientificRecord","identifier":"translation:es:constant-time","kind":"lesson","label":{"@value":"Una progresión, distintas lecturas de reloj","@language":"es"},"description":{"@value":"La progresión universal T es una elección de modelo. Las diferencias observadas entre relojes requieren una explicación; no establecen un reloj absoluto detectable.","@language":"es"},"language":"es","status":"Educational translation","recordPage":"https://beyondspacetime.org/global/es/constant-time/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/155"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/es/lessons/1"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Aconstant-time"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Aconstant-time","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Aconstant-time"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Acosmic-age","@type":"ScientificRecord","identifier":"translation:es:cosmic-age","kind":"lesson","label":{"@value":"Edad cosmológica e historia total","@language":"es"},"description":{"@value":"La edad cosmológica convencional se infiere de una historia de expansión calibrada. La duración de toda realidad física hipotética es otra cuestión.","@language":"es"},"language":"es","status":"Educational translation","recordPage":"https://beyondspacetime.org/global/es/cosmic-age/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/164"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/es/lessons/10"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Acosmic-age"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Acosmic-age","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Acosmic-age"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Acosmic-size","@type":"ScientificRecord","identifier":"translation:es:cosmic-size","kind":"lesson","label":{"@value":"Horizonte y extensión del cosmos","@language":"es"},"description":{"@value":"Un alcance causal finito no determina la extensión total. El horizonte observable no es necesariamente una pared material.","@language":"es"},"language":"es","status":"Educational translation","recordPage":"https://beyondspacetime.org/global/es/cosmic-size/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/163"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/es/lessons/9"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Acosmic-size"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Acosmic-size","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Acosmic-size"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Adistance-inference","@type":"ScientificRecord","identifier":"translation:es:distance-inference","kind":"lesson","label":{"@value":"Distancias y tamaños astronómicos","@language":"es"},"description":{"@value":"Las correcciones de distancia pueden tener ambos signos. La premisa de objetos más pequeños y cercanos no es una corrección universal establecida.","@language":"es"},"language":"es","status":"Educational translation","recordPage":"https://beyondspacetime.org/global/es/distance-inference/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/165"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/es/lessons/11"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Adistance-inference"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Adistance-inference","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Adistance-inference"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Afastest-signal","@type":"ScientificRecord","identifier":"translation:es:fastest-signal","kind":"lesson","label":{"@value":"Velocidad de grupo y causalidad","@language":"es"},"description":{"@value":"Una característica de campo puede superar la velocidad de un paquete lento sin superar el límite causal local. No se demuestra ninguna señal controlable más rápida que la luz.","@language":"es"},"language":"es","status":"Educational translation","recordPage":"https://beyondspacetime.org/global/es/fastest-signal/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/161"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/es/lessons/7"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Afastest-signal"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Afastest-signal","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Afastest-signal"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Alight-slowing","@type":"ScientificRecord","identifier":"translation:es:light-slowing","kind":"lesson","label":{"@value":"Energía y velocidad durante la propagación","@language":"es"},"description":{"@value":"Energía, frecuencia y velocidad de grupo son distintas. En el modelo de arrastre con brecha fija puede perderse energía con un cambio de velocidad muy pequeño; sin brecha no disminuye la velocidad.","@language":"es"},"language":"es","status":"Educational translation","recordPage":"https://beyondspacetime.org/global/es/light-slowing/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/156"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/es/lessons/2"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Alight-slowing"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Alight-slowing","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Alight-slowing"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Aphoton-mass","@type":"ScientificRecord","identifier":"translation:es:photon-mass","kind":"lesson","label":{"@value":"Luz, energía y masa invariante","@language":"es"},"description":{"@value":"La luz transporta energía y momento medibles. Una masa invariante no nula del fotón es una hipótesis distinta, no una consecuencia de la presión de radiación ni de la gravedad.","@language":"es"},"language":"es","status":"Educational translation","recordPage":"https://beyondspacetime.org/global/es/photon-mass/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/154"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/es/lessons/0"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Aphoton-mass"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Aphoton-mass","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Aphoton-mass"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Aphysical-existence","@type":"ScientificRecord","identifier":"translation:es:physical-existence","kind":"lesson","label":{"@value":"Existencia física y masa de un sistema","@language":"es"},"description":{"@value":"La energía y el momento son medibles. La masa equivalente de energía, la masa invariante y la extensión geométrica son conceptos diferentes.","@language":"es"},"language":"es","status":"Educational translation","recordPage":"https://beyondspacetime.org/global/es/physical-existence/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/159"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/es/lessons/5"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Aphysical-existence"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Aphysical-existence","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Aphysical-existence"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Aseparation","@type":"ScientificRecord","identifier":"translation:es:separation","kind":"lesson","label":{"@value":"Separación de objetos y velocidad local","@language":"es"},"description":{"@value":"Una tasa de separación en coordenadas puede superar c sin que un cuerpo o una señal lo haga localmente.","@language":"es"},"language":"es","status":"Educational translation","recordPage":"https://beyondspacetime.org/global/es/separation/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/162"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/es/lessons/8"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Aseparation"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Aseparation","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Aseparation"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Aspacetime","@type":"ScientificRecord","identifier":"translation:es:spacetime","kind":"lesson","label":{"@value":"Geometría y sustancia física","@language":"es"},"description":{"@value":"La geometría relativista tiene éxito predictivo. Rechazar una metáfora de tejido literal no invalida los tiempos propios, las trayectorias o la gravedad medidos.","@language":"es"},"language":"es","status":"Educational translation","recordPage":"https://beyondspacetime.org/global/es/spacetime/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/160"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/es/lessons/6"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Aspacetime"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Aspacetime","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Aspacetime"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Awhen","@type":"ScientificRecord","identifier":"translation:es:when","kind":"lesson","label":{"@value":"El cuándo: eventos y llegada de pulsos","@language":"es"},"description":{"@value":"La carta considera el cuándo una relación entre eventos. Esta elección ontológica no equivale a negar las duraciones medidas ni el tiempo propio relativista.","@language":"es"},"language":"es","status":"Educational translation","recordPage":"https://beyondspacetime.org/global/es/when/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/157"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/es/lessons/3"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Awhen"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Awhen","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Awhen"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Awhere","@type":"ScientificRecord","identifier":"translation:es:where","kind":"lesson","label":{"@value":"El dónde: posición relativa y geometría","@language":"es"},"description":{"@value":"La posición relativa, la separación y la geometría son medibles. No considerar el espacio una sustancia no elimina las leyes geométricas.","@language":"es"},"language":"es","status":"Educational translation","recordPage":"https://beyondspacetime.org/global/es/where/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/158"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/es/lessons/4"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Awhere"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Awhere","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Awhere"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Aconstant-time","@type":"ScientificRecord","identifier":"translation:fr:constant-time","kind":"lesson","label":{"@value":"Une progression, des horloges différentes","@language":"fr"},"description":{"@value":"La progression universelle T est un choix de modèle. Les différences de comptage des horloges demandent une explication, mais ne prouvent pas une horloge absolue détectable.","@language":"fr"},"language":"fr","status":"Educational translation","recordPage":"https://beyondspacetime.org/global/fr/constant-time/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/177"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/fr/lessons/1"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Aconstant-time"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Aconstant-time","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Aconstant-time"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Acosmic-age","@type":"ScientificRecord","identifier":"translation:fr:cosmic-age","kind":"lesson","label":{"@value":"Âge cosmologique et histoire totale","@language":"fr"},"description":{"@value":"L’âge cosmologique conventionnel est inféré d’une histoire d’expansion calibrée. La durée de toute réalité physique hypothétique est une autre question.","@language":"fr"},"language":"fr","status":"Educational translation","recordPage":"https://beyondspacetime.org/global/fr/cosmic-age/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/186"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/fr/lessons/10"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Acosmic-age"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Acosmic-age","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Acosmic-age"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Acosmic-size","@type":"ScientificRecord","identifier":"translation:fr:cosmic-size","kind":"lesson","label":{"@value":"Horizon et étendue du cosmos","@language":"fr"},"description":{"@value":"Une portée causale finie ne détermine pas l’étendue physique totale. L’horizon observable n’est pas nécessairement une paroi matérielle.","@language":"fr"},"language":"fr","status":"Educational translation","recordPage":"https://beyondspacetime.org/global/fr/cosmic-size/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/185"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/fr/lessons/9"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Acosmic-size"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Acosmic-size","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Acosmic-size"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Adistance-inference","@type":"ScientificRecord","identifier":"translation:fr:distance-inference","kind":"lesson","label":{"@value":"Distances et tailles astronomiques","@language":"fr"},"description":{"@value":"Les corrections de distance peuvent être de l’un ou l’autre signe. La prémisse « plus petits et plus proches » n’est pas une correction universelle établie.","@language":"fr"},"language":"fr","status":"Educational translation","recordPage":"https://beyondspacetime.org/global/fr/distance-inference/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/187"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/fr/lessons/11"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Adistance-inference"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Adistance-inference","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Adistance-inference"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Afastest-signal","@type":"ScientificRecord","identifier":"translation:fr:fastest-signal","kind":"lesson","label":{"@value":"Vitesse de groupe et causalité","@language":"fr"},"description":{"@value":"Une caractéristique de champ peut être plus rapide qu’un paquet lent sans dépasser la limite causale locale. Aucun signal supraluminique contrôlable n’est démontré.","@language":"fr"},"language":"fr","status":"Educational translation","recordPage":"https://beyondspacetime.org/global/fr/fastest-signal/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/183"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/fr/lessons/7"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Afastest-signal"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Afastest-signal","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Afastest-signal"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Alight-slowing","@type":"ScientificRecord","identifier":"translation:fr:light-slowing","kind":"lesson","label":{"@value":"Énergie et vitesse pendant la propagation","@language":"fr"},"description":{"@value":"Énergie, fréquence et vitesse de groupe sont distinctes. Un freinage à seuil fixe peut faire perdre de l’énergie avec très peu de variation de vitesse ; sans seuil, la vitesse reste constante.","@language":"fr"},"language":"fr","status":"Educational translation","recordPage":"https://beyondspacetime.org/global/fr/light-slowing/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/178"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/fr/lessons/2"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Alight-slowing"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Alight-slowing","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Alight-slowing"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Aphoton-mass","@type":"ScientificRecord","identifier":"translation:fr:photon-mass","kind":"lesson","label":{"@value":"Lumière, énergie et masse invariante","@language":"fr"},"description":{"@value":"La lumière transporte une énergie et une quantité de mouvement mesurables. Une masse invariante non nulle du photon constitue une hypothèse distincte, non une conséquence de la pression de radiation ou de la gravité.","@language":"fr"},"language":"fr","status":"Educational translation","recordPage":"https://beyondspacetime.org/global/fr/photon-mass/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/176"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/fr/lessons/0"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Aphoton-mass"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Aphoton-mass","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Aphoton-mass"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Aphysical-existence","@type":"ScientificRecord","identifier":"translation:fr:physical-existence","kind":"lesson","label":{"@value":"Existence physique et masse d’un système","@language":"fr"},"description":{"@value":"Énergie et quantité de mouvement sont mesurables. Masse équivalente énergétique, masse invariante et extension géométrique sont des notions distinctes.","@language":"fr"},"language":"fr","status":"Educational translation","recordPage":"https://beyondspacetime.org/global/fr/physical-existence/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/181"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/fr/lessons/5"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Aphysical-existence"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Aphysical-existence","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Aphysical-existence"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Aseparation","@type":"ScientificRecord","identifier":"translation:fr:separation","kind":"lesson","label":{"@value":"Séparation des objets et vitesse locale","@language":"fr"},"description":{"@value":"Un taux de séparation en coordonnées peut dépasser c sans qu’un corps ou un signal dépasse localement c.","@language":"fr"},"language":"fr","status":"Educational translation","recordPage":"https://beyondspacetime.org/global/fr/separation/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/184"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/fr/lessons/8"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Aseparation"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Aseparation","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Aseparation"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Aspacetime","@type":"ScientificRecord","identifier":"translation:fr:spacetime","kind":"lesson","label":{"@value":"Géométrie et substance physique","@language":"fr"},"description":{"@value":"La géométrie relativiste est un cadre prédictif efficace. Rejeter la métaphore d’un tissu matériel ne réfute pas les temps propres, les trajectoires ou la gravité mesurés.","@language":"fr"},"language":"fr","status":"Educational translation","recordPage":"https://beyondspacetime.org/global/fr/spacetime/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/182"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/fr/lessons/6"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Aspacetime"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Aspacetime","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Aspacetime"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Awhen","@type":"ScientificRecord","identifier":"translation:fr:when","kind":"lesson","label":{"@value":"Le quand : événements et arrivée des impulsions","@language":"fr"},"description":{"@value":"La charte traite le quand comme une relation entre événements. Ce choix ontologique se distingue des durées mesurées et du temps propre relativiste.","@language":"fr"},"language":"fr","status":"Educational translation","recordPage":"https://beyondspacetime.org/global/fr/when/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/179"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/fr/lessons/3"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Awhen"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Awhen","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Awhen"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Awhere","@type":"ScientificRecord","identifier":"translation:fr:where","kind":"lesson","label":{"@value":"Le où : position relative et géométrie","@language":"fr"},"description":{"@value":"Position relative, séparation et géométrie sont mesurables. Ne pas considérer l’espace comme une substance ne supprime pas les lois géométriques.","@language":"fr"},"langu