time.org/knowledge-graph/record/?id=translation%3Afr%3Aconstant-time"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Acosmic-age","@type":"ScientificRecord","identifier":"translation:en:cosmic-age","kind":"lesson","label":{"@value":"Modeled cosmic age and total history","@language":"en"},"description":{"@value":"The conventional cosmic age is an inference from a calibrated expansion history. The duration of all hypothetical physical reality is a different, unanswered question.","@language":"en"},"language":"en","status":"Educational lesson","recordPage":"https://beyondspacetime.org/global/en/cosmic-age/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/142"},{"catalog":"https://beyondspacetime.org/global/catalog.json","sha256":"e647b09b36b820d494d24fca8f0d1dba1c1d9fc7700adf4813871c7161b9c3b8","pointer":"/languages/en/lessons/10"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","adaptsLesson":["https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Acosmic-age"],"languageVariant":["https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aes%3Acosmic-age","https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Afr%3Acosmic-age"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=translation%3Aen%3Acosmic-size","@type":"ScientificRecord","identifier":"translation:en:cosmic-size","kind":"lesson","label":{"@value":"Observable reach and total cosmic extent","@language":"en"},"description":{"@value":"A finite causal reach does not determine the total physical extent of the universe. The observable horizon is not necessarily a material wall.","@language":"en"},"language":"en","status":"Educational lesson","recordPage":"https://beyondspacetime.org/global/en/cosmic-size/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b7