ime","kind":"foundation","label":{"@value":"Geometry versus a literal fabric","@language":"en"},"description":{"@value":"Relativistic geometry is a successful predictive framework. Rejecting a literal fabric metaphor does not reject measured proper times, trajectories or gravity.","@language":"en"},"language":"en","status":"charter_premise","recordPage":"https://beyondspacetime.org/foundations/spacetime/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/17"},{"catalog":"https://beyondspacetime.org/foundations/catalog.json","sha256":"0e8595421f153d85514f49d8777a6570f58dabecd0b7b1d240357f91acba2c0c","pointer":"/lessons/6"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","explainsPremise":["https://beyondspacetime.org/knowledge-graph/record/?id=premise%3Aspacetime"],"usesModel":["https://beyondspacetime.org/knowledge-graph/record/?id=model%3Afoundation%3Aspacetime"]},{"@id":"https://beyondspacetime.org/knowledge-graph/record/?id=foundation%3Awhen","@type":"ScientificRecord","identifier":"foundation:when","kind":"foundation","label":{"@value":"Time as event ordering","@language":"en"},"description":{"@value":"The charter treats When as a relation between events. That ontological choice must be distinguished from measured duration and relativistic proper time.","@language":"en"},"language":"en","status":"charter_premise","recordPage":"https://beyondspacetime.org/foundations/when/","provenance":[{"catalog":"https://beyondspacetime.org/museum/catalog.json","sha256":"2a7b79101df2e42c4115528a997b8b262490f16b5e7db4215b003a014e6ba857","pointer":"/entries/14"},{"catalog":"https://beyondspacetime.org/foundations/catalog.json","sha256":"0e8595421f153d85514f49d8777a6570f58dabecd0b7b1d240357f91acba2c0c","pointer":"/lessons/3"}],"sourcePage":"https://arcsecs.com/read-scientific-paper/","explainsPremise":["https://beyondspacetime.org/knowledge-graph/rec